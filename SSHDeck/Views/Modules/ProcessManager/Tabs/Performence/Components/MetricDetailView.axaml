<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:SSHDeck.Views.Modules.ProcessManager.Tabs.Performence.Components"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SSHDeck.Views.Modules.ProcessManager.Tabs.Performence.Components.MetricDetailView">
    
    <Grid RowDefinitions="*, Auto" Background="DarkGoldenrod">
        
        <StackPanel
            Orientation="Vertical">
            
            <local:ChartView Grid.Column="0"
                             DataContext="{Binding Chart}"
                             Width="60" Height="40"
                             Margin="0,0,12,0" />
            
        </StackPanel>
        
    </Grid>
    
</UserControl>
