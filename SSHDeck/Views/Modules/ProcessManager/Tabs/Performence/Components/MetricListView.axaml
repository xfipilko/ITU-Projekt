<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SSHDeck.ViewModels.Modules.ProcessManager.Tabs.Performence.Components"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="SSHDeck.Views.Modules.ProcessManager.Tabs.Performence.Components.MetricListView"
             x:DataType="vm:MetricListViewModel">

    <Grid Width="240">
        <ItemsControl ItemsSource="{Binding Items}" />
    </Grid>
    
</UserControl>